MODAM_DATABASE_PASSWORD=replace-with-generated-url-safe-secret
MODAM_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
MODAM_CHAT_PORT=3300
MODAM_NODE_ENV=development
MODAM_PUBLIC_ORIGINS=http://127.0.0.1:3300,http://localhost:3300
# Production uses MODAM_NODE_ENV=production and an explicit HTTPS origin.
# Terminate TLS at a reverse proxy reaching the loopback chat port.
