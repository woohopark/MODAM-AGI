# Inject environment variables securely; .env is not loaded automatically.
GROQ_API_KEY=
MODAM_GROQ_MODEL=openai/gpt-oss-120b
MODAM_GROQ_TIMEOUT_SECONDS=30
MODAM_TOOL_TIMEOUT_SECONDS=15
MODAM_RUN_TIMEOUT_SECONDS=90
MODAM_MAX_MODEL_CALLS=4
MODAM_MAX_TOOL_CALLS=4
MODAM_MAX_REPLANS=1
MODAM_MAX_EVIDENCE_CHARS=20000
